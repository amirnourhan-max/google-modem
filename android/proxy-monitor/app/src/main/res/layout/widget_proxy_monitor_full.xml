<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_v2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/full_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proxy Monitor"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_connection_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ Disconnected"
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/full_controls_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/full_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:text="Connect"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_disconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger"
            android:gravity="center"
            android:text="Disconnect"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_refresh"
            android:gravity="center"
            android:text="↻ Refresh"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/full_tabs_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/full_tab_monitor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_refresh"
            android:gravity="center"
            android:text="● Monitor"
            android:textColor="@color/cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_tab_passwall2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_refresh"
            android:gravity="center"
            android:text="PassWall2"
            android:textColor="#8FA7C7"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/full_monitor_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/full_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="🌐 —"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/full_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/full_xray"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xray —"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_singbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sing-Box —"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/full_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="🧭 —"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/full_traffic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="↓ —    ↑ —"
        android:textColor="@color/cyan"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/full_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="Updated —"
        android:textColor="#D7E3F4"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/full_nodes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="📡 ACTIVE NODES"
        android:textColor="#9DB0C9"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/full_nodes_frame"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="4dp"
        android:clipChildren="false">

        <ListView
            android:id="@+id/full_nodes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/full_nodes_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_widget_node"
            android:gravity="center"
            android:text="No active nodes"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/full_passwall_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/full_passwall_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PassWall2 Router Panel"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_passwall_core"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_widget_node"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Proxy core: —"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_passwall_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Active profile: —"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/full_passwall_nodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Visible active nodes: —"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/full_open_passwall2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:text="Open PassWall2 Panel"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/full_passwall_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Opens LuCI in browser • login may be required"
            android:textColor="#8FA7C7"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/full_passwall_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="Updated —"
            android:textColor="#D7E3F4"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
